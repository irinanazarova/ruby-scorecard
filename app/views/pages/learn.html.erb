          <marker id="svg-arrowhead" viewBox="0 0 8 8" refX="7" refY="4"
                  markerWidth="6" markerHeight="6" orient="auto">
            <path class="svg-pip" d="M0 1 L7 4 L0 7 z"/>
          </marker>
        </defs>

        <text class="svg-cap" x="74"  y="18" text-anchor="middle">YOU</text>
        <text class="svg-cap" x="247" y="18" text-anchor="middle">GATE 1 · COLLECTION</text>
        <text class="svg-cap" x="447" y="18" text-anchor="middle">GATE 2 · FILTERING</text>
        <text class="svg-cap" x="641" y="18" text-anchor="middle">RESULT</text>

        <%# Web lane %>
        <rect class="svg-box" x="8" y="42" width="132" height="66" rx="8"/>
        <text class="svg-t" x="74" y="70" text-anchor="middle">Your docs site
          <tspan class="svg-s" x="74" dy="17">a web page</tspan></text>
