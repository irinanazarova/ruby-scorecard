<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Is your documentation in the training data?" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%# Applies the saved theme BEFORE first paint, so a dark-theme visitor never sees a white
        flash. Must stay inline and ahead of the stylesheet. Same key the scorecard uses, so the
        theme carries across from the static pages to /test. %>
    <script>(function(){try{var t=localStorage.getItem('rsc-theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t;}catch(e){}})();</script>

    <%# The design system from the static site: same tokens, fonts and colours as the scorecard,
        so /test does not look like a different product bolted on. build.sh puts it in public/. %>
    <link rel="stylesheet" href="/assets/styles.css">
    <%= stylesheet_link_tag "analyzer", "data-turbo-track": "reload" %>

    <%# Where to connect, and the JWT that gets us past AnyCable's connection check. Both are read
        by app/javascript/cable.js. Without the URL the browser falls back to /cable, which nothing
        serves in production; without the token AnyCable drops the socket as "unauthorized". Either
        way the failure is silent — results simply never stream. %>
    <%= action_cable_meta_tag %>
    <% if anycable_token %>
      <meta name="anycable-token" content="<%= anycable_token %>">
    <% end %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="analyzer">
    <header class="analyzer__header">
      <a class="analyzer__brand" href="/">Ruby &amp; Rails LLM scorecard</a>
      <nav class="analyzer__nav">
        <%# aria-current follows the request rather than being hardcoded on one link, which used to
            mark "Test a page" as current on every page in this layout. %>
        <a href="/learn" <%= 'aria-current=page'.html_safe if current_page?("/learn") %>>Learn</a>
        <a href="<%= test_path %>" <%= 'aria-current=page'.html_safe if current_page?(test_path) %>>Test a page</a>
        <%# The GitHub mark (Octicons, MIT); scripts/site_nav.rb carries the same icon for the
            generated pages. Keep the two in step. %>
        <a class="nav-gh" href="https://github.com/irinanazarova/ruby-scorecard" aria-label="Source on GitHub" title="Source on GitHub"><svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg></a>
        <%# The scorecard's own toggle, driven by the nanotags bundle loaded at the end of <body>.
            Without it /test was the one page on the site with no way to change theme. %>
        <theme-toggle>
          <button type="button" data-ref="button" class="theme-toggle" aria-label="Colour theme: following your device. Click for light.">
            <span class="theme-toggle__dot"></span><span class="theme-toggle__label">Auto</span>
          </button>
        </theme-toggle>
        <% if signed_in? %>
          <span class="analyzer__user">
            <%= current_user.login %>
            <small>$<%= current_user.spent_dollars %> / $<%= current_user.budget_dollars %></small>
          </span>
          <%= button_to "Sign out", sign_out_path, method: :delete, class: "analyzer__linkbtn" %>
        <% end %>
      </nav>
    </header>

    <% if flash[:alert] %><p class="analyzer__flash analyzer__flash--warn"><%= flash[:alert] %></p><% end %>
    <% if flash[:notice] %><p class="analyzer__flash"><%= flash[:notice] %></p><% end %>

    <main class="analyzer__main"><%= yield %></main>

    <%# The scorecard's nanotags bundle: defines <theme-toggle> (and the table components the
        static pages use). Separate from the importmap app, which carries Turbo and AnyCable. %>
    <script type="module" src="/assets/app.js"></script>

    <footer class="analyzer__footer">
      <p>These are proxies, not ground truth. The quality gate is the open FineWeb-Edu classifier,
      not any lab's actual filter, and a memorization probe can show a page <em>was</em> seen but
      never prove it was not. <a href="/learn">How this works, and the measurements behind it &rarr;</a></p>
    </footer>
  </body>
</html>
