<%# Overall progress. Kept separate so a step landing does not re-render the whole page. %>
<p class="status status--<%= analysis.status %>" id="analysis_status">
  <% case analysis.status
     when "pending" then %>Queued…<%
     when "running" then %>Running. Fast checks appear first; Common Crawl and the model probes take longer.<%
     when "done" then %>
       Done<% if analysis.replayed? %>, replayed from cache<% end %>.
       <% if analysis.cost_millicents.positive? %>
         <small>Model spend: <%= (analysis.cost_millicents / 1000.0).round(3) %> dollars</small>
       <% end %>
     <%
     when "failed" then %>Something failed. Partial results are shown below.<%
     end %>
</p>
