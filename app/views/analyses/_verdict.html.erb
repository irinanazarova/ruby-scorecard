<%# The answer, at the top, stated as soon as any evidence allows and sharpened as the rest lands.
    Rendered bare: this element carries the id the broadcast replaces, so wrapping it in the page
    would nest the same id twice. %>
<div class="answers" id="analysis_verdict">
  <% Analyzer::Verdict.new(payloads, status: status).answers.each do |a| %>
    <article class="answer answer--<%= a.tone %> answer--<%= a.state %>">
      <p class="answer__q"><%= a.question %></p>
      <p class="answer__headline"><%= a.headline %></p>
      <% if a.detail.present? %><p class="answer__detail"><%= a.detail %></p><% end %>

      <% if a.cues.any? %>
        <ul class="cues">
          <% a.cues.each do |cue| %>
            <li class="cue cue--<%= cue.status %>">
              <span class="cue__dot" aria-hidden="true"></span><%= cue.label %>
            </li>
          <% end %>
        </ul>
      <% end %>

      <% if a.caveat.present? %><p class="answer__caveat"><%= a.caveat %></p><% end %>
    </article>
  <% end %>
</div>
