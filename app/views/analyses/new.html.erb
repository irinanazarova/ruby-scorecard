<% content_for :title, "Can agents find, read and recall your product?" %>

<section class="probe-hero">
  <%# Shown for the demo: the room needs the address to type, and reading it off a slide is easier
      than reading it out of a browser chrome that is cropped or zoomed on the projector. %>
  <p class="probe-hero__url">ruby.evilmartians.com/test</p>
  <h1>Can agents find, read and recall your product?</h1>
  <p class="probe-hero__lead">
    Two questions, measured separately. Can an agent discover your product, read it and suggest it
    today? And is your text already inside the models, word for word?
    <a href="/learn">How the whole system works &rarr;</a>
  </p>

  <%# Two named fields, because the answer depends on both and guessing the missing half was the
      worst thing the old single box did: it walked from "a repo named after this site" down to
      "the org's most-starred repo", and that last step renders exactly like a measurement. %>
  <%# Server-side validation is the source of truth; the Stimulus counter below is progressive
      enhancement over it. With JS off the form still refuses a short paragraph, and the message is
      the same one, because both read Passage::MIN_PASTED_WORDS. %>
  <% if @form.errors[:base].any? %>
    <div class="form-errors" role="alert">
      <% @form.errors[:base].each do |message| %><p><%= message %></p><% end %>
    </div>
  <% end %>

  <%= form_with url: analyses_path, method: :post, class: "probe-form",
                data: { controller: "word-count",
                        word_count_min_value: Analyzer::Passage::MIN_PASTED_WORDS } do |f| %>
    <div class="probe-form__field">
      <%= f.label :docs_url, "Your documentation website" %>
      <%= f.text_field :docs_url, value: @form.docs_url,
            placeholder: "https://yourcompany.com/docs/getting-started",
            autofocus: true, autocomplete: "off", spellcheck: "false" %>
      <span class="probe-form__hint">One content page, not the docs landing page. Landing pages are
      mostly links and there is nothing in them to test.</span>
      <%= render "analyses/field_error", messages: @form.errors[:docs_url] %>
    </div>

    <div class="probe-form__field">
      <%= f.label :repo, "Your open source repo" %>
      <%= f.text_field :repo, value: @form.repo,
            placeholder: "owner/repo", autocomplete: "off", spellcheck: "false" %>
      <span class="probe-form__hint">Docs, SDK or the product itself, whichever is public.</span>
      <%= render "analyses/field_error", messages: @form.errors[:repo] %>
    </div>

    <%# The third thing you can check, and the only one that needs no URL at all: text, pasted.
        Boilerplate copied across many repos is the case our own study found most likely to be
        memorized, so this is the field to reach for when you want to know whether a specific
        paragraph is already inside the models. %>
    <%# tag.details rather than a literal details tag with the attribute interpolated: an ERB output
        sitting in attribute position parses ambiguously. Quoting it instead would not work either,
        since an empty open attribute is still a present boolean one and would open the box always.

        No ERB delimiters in this text. They do not nest, so one here ends the comment early and the
        rest becomes markup, which is the second time that has broken a file in this directory. %>
    <%= tag.details class: "probe-form__paste",
                    open: @form.passage.present? || @form.errors[:passage].any? do %>
      <summary>Or check a paragraph directly</summary>
      <div class="probe-form__field">
        <div class="probe-form__labelrow">
          <%= f.label :passage, "Paste the text" %>
          <%# Words rather than characters: words are what the probe requires, so a character
              counter would say "fine" and the server would then refuse. %>
          <span class="wordcount" data-word-count-target="output" aria-live="polite"></span>
        </div>
        <%= f.text_area :passage, value: @form.passage, rows: 5, spellcheck: "false",
              data: { word_count_target: "input", action: "input->word-count#update" } %>
        <span class="probe-form__hint">We show each model the opening words and compare what it
        writes next against the rest, so this needs at least
        <%= Analyzer::Passage::MIN_PASTED_WORDS %> words. Text repeated across many repos is the
        case most likely to fire.</span>
        <%= render "analyses/field_error", messages: @form.errors[:passage] %>
      </div>
    <% end %>

    <div class="probe-form__submit">
      <%= f.submit "Analyze", data: { word_count_target: "submit" } %>
      <span class="probe-form__hint">Any box may be left empty. We need at least one, and we never
      guess the others.</span>
      <%# A disabled button needs its reason in the same glance. The controller also opens the paste
          box when that is what is blocking submission, so the count is never hidden behind a summary. %>
      <span class="probe-form__reason" data-word-count-target="reason" role="alert" hidden></span>
    </div>
  <% end %>

  <p class="probe-form__quota">
    <% if signed_in? %>
      Signed in as <strong><%= current_user.login %></strong>.
      $<%= current_user.spent_dollars %> of $<%= current_user.budget_dollars %> used.
    <% else %>
      <strong><%= free_remaining %></strong> of
      <%= AnalyzerConfig.free_analyses_per_session %> free checks left.
      Re-running a pair you already checked is free and never uses one up.
      <%= button_to "Sign in with GitHub", "/auth/github", method: :post, class: "analyzer__linkbtn",
                    data: { turbo: false } %>
    <% end %>
  </p>

  <section class="examples">
    <h2>Or start with one of these</h2>
    <ul class="examples__list">
      <% @examples.each do |example| %>
        <li class="example">
          <div class="example__pair">
            <span class="example__label"><%= example[:label] %></span>
            <code class="example__docs"><%= example[:docs].sub(%r{\Ahttps?://}, "") %></code>
            <code class="example__repo"><%= example[:repo] %></code>
          </div>
          <div class="example__go">
            <%= button_to "Run it", analyses_path,
                  params: { docs_url: example[:docs], repo: example[:repo] }, class: "examples__btn" %>
          </div>
        </li>
      <% end %>
    </ul>
  </section>
</section>

<% if @recent.any? %>
  <section class="recent">
    <h2>Your recent checks</h2>
    <ul>
      <% @recent.each do |a| %>
        <li><%= link_to a.input, analysis_path(a) %> <small><%= time_ago_in_words(a.created_at) %> ago</small></li>
      <% end %>
    </ul>
  </section>
<% end %>
