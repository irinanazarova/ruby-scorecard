<% content_for :title, "#{@analysis.status == 'done' ? 'Results for' : 'Analyzing'} #{@analysis.input}" %>
<%= turbo_stream_from @analysis %>

<%# data-analysis-sync-* : the safety net for a broadcast that arrives before the socket does.
    A fully cached run finishes in ~1.5s, which is faster than the WebSocket connects, so every
    region was broadcast into a page that was not yet listening and the visitor sat in front of an
    empty deck with the finished results already in the database. The controller re-fetches this
    page until it reads as done, so the answer converges whatever the cable does.

    data-controller order matters: reveal owns the stage wrappers, analysis-sync only ever swaps
    the regions INSIDE them, so a broadcast never resets how far the visitor has walked. %>
<section class="deck" data-controller="reveal analysis-sync"
         data-action="click->reveal#advance"
         data-reveal-revealed-value="1"
         data-analysis-sync-status-value="<%= @analysis.status %>"
         data-analysis-sync-url-value="<%= analysis_path(@analysis) %>">

  <% stored = @analysis.step_payloads %>

  <header class="deck__head">
    <p class="deck__back"><%= link_to "&larr; Check another".html_safe, test_path %></p>
    <div class="deck__target">
      <% if @analysis.docs_url.present? %>
        <span class="chip chip--docs"><span class="chip__key">docs</span>
          <a href="<%= @analysis.docs_url %>" rel="noopener"><%= @analysis.docs_url.sub(%r{\Ahttps?://}, "") %></a>
        </span>
      <% end %>
      <% if @analysis.repo.present? %>
        <span class="chip chip--repo"><span class="chip__key">repo</span>
          <a href="https://github.com/<%= @analysis.repo %>" rel="noopener"><%= @analysis.repo %></a>
        </span>
      <% end %>
      <% if @analysis.passage.present? %>
        <span class="chip chip--passage"><span class="chip__key">paragraph</span>
          <%= @analysis.passage.split.size %> words
        </span>
      <% end %>
    </div>

    <%# The pasted text itself, shown rather than summarised. A probe you cannot see the input to is
        not evidence of anything, and on stage the paragraph IS the point. %>
    <% if @analysis.passage.present? %>
      <details class="deck__passage">
        <summary>The paragraph being checked</summary>
        <blockquote><%= @analysis.passage %></blockquote>
      </details>
    <% end %>
    <%= render "analyses/status", analysis: @analysis %>
  </header>

  <%# The deck adapts to what was actually filled in. A run that is only a pasted paragraph has no
      site to fetch and no repo to read, so the first two slides would be nothing but "nothing given
      to check", and the numbering has to follow or the visitor is told they are on slide 3 of 4
      with two missing. %>
  <% slides = [
       ["agent",  "Agent experience", "Can an agent discover your product, evaluate it, and suggest it?"],
       ["funnel", "How text reaches a model", "Two pipelines, each throwing most of its input away. Where does yours stop?"],
       ["recall", "Model recall", "The same probe on every column: the opening words in, longest exact continuation out."],
       ["actions", "What to do next", "Ranked by how much it changes, for this result rather than in general."]
     ] %>
  <% slides = slides.reject { |key, _, _| %w[agent funnel actions].include?(key) } if @analysis.passage_only? %>

  <div class="deck__stages">
    <% slides.each_with_index do |(key, title, lead), i| %>
      <section class="stage" data-reveal-target="stage" id="stage-<%= key %>">
        <p class="stage__number"><%= i + 1 %> of <%= slides.size %></p>
        <h2 class="stage__title"><%= title %></h2>
        <p class="stage__lead"><%= lead %></p>

        <% case key
           when "agent" %>
          <%= render "analyses/discoverability", payloads: stored %>
        <% when "funnel" %>
          <%= render "analyses/funnel", payloads: stored %>
        <% when "recall" %>
          <%= render "analyses/recall", payloads: stored %>
        <% when "actions" %>
          <%= render "analyses/actions", payloads: stored %>
        <% end %>

        <%# The working hangs off the LAST slide, whichever that turns out to be.

            A step that has already answered renders from the stored results, so a reload or a
            shared permalink shows the finished analysis. Only steps still in flight render the
            placeholder and wait for their broadcast. Finished steps render the partial bare: it
            carries the step id itself, which is what the broadcast replaces, so wrapping it would
            nest the same id twice. %>
        <% if i == slides.size - 1 %>
          <details class="deck__evidence" id="evidence">
            <summary>All the working, check by check</summary>
            <div class="steps">
              <% Analysis::STEPS.each do |step, step_title, hint| %>
                <% next if @analysis.passage_only? && step != "memorization" %>
                <% if (payload = stored[step]) %>
                  <%= render "analyses/step", step: step, payload: payload, analysis: @analysis %>
                <% else %>
                  <%= tag.div id: "step_#{step}" do %>
                    <%= render "analyses/pending", title: step_title, hint: hint %>
                  <% end %>
                <% end %>
              <% end %>
            </div>
          </details>
        <% end %>
      </section>
    <% end %>
  </div>

  <%# The deck controls. Fixed to the bottom of the viewport, so the prompt to advance is visible
      whatever the visitor has scrolled to.

      A one-slide run gets none: a disabled Next button and a single dot are controls for a deck
      that does not exist. %>
  <nav class="deck__nav" aria-label="Slides" data-no-advance <%= "hidden" if slides.size < 2 %>>
    <button type="button" class="deck__btn" data-reveal-target="back" data-action="reveal#back"
            aria-label="Previous slide">&larr;</button>
    <span class="deck__dots" aria-hidden="true">
      <% slides.size.times do %><span class="dot" data-reveal-target="dot"></span><% end %>
    </span>
    <button type="button" class="deck__btn deck__btn--go" data-reveal-target="forward"
            data-action="reveal#next">Next &rarr;</button>
    <span class="deck__hint" data-reveal-target="hint">Press <kbd>&rarr;</kbd> or <kbd>Enter</kbd>,
    or click anywhere</span>
    <button type="button" class="deck__all" data-reveal-target="all" data-action="reveal#all">
      Show everything
    </button>
  </nav>
</section>
