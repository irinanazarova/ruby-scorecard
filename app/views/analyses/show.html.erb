<% content_for :title, "#{@analysis.status == 'done' ? 'Results for' : 'Analyzing'} #{@analysis.input}" %>
<%= turbo_stream_from @analysis %>

<%# data-analysis-sync-* : the safety net for a broadcast that arrives before the socket does.
    A fully cached run finishes in ~1.5s, which is faster than the WebSocket connects, so every
    step was broadcast into a page that was not yet listening and the visitor sat in front of four
    "waiting" boxes with the finished results already in the database. The controller re-fetches
    this page until it reads as done, so the answer converges whatever the cable does. %>
<section class="result" data-controller="analysis-sync"
         data-analysis-sync-status-value="<%= @analysis.status %>"
         data-analysis-sync-url-value="<%= analysis_path(@analysis) %>">
  <p class="result__back"><%= link_to "&larr; Check another".html_safe, test_path %></p>
  <h1 class="result__target"><%= @analysis.input %></h1>

  <% stored = @analysis.step_payloads %>

  <%# The answer comes first, then what to do about it, then the working. A visitor who reads only
      the top of this page should still leave knowing their situation and their next move.

      The progress line sits above the answer rather than between the answer and the advice: while
      a run is filling it explains why, and once the run is done it is the least interesting line
      on the page. %>
  <%= render "analyses/status", analysis: @analysis %>

  <%= render "analyses/verdict", payloads: stored, status: @analysis.status %>

  <%= render "analyses/actions", payloads: stored %>

  <h2 class="evidence__title" id="evidence">The evidence</h2>

  <%# Order is the argument, not just the loading order: can an agent read it, could it ever be
      trained on, and did that actually happen. Each box fills as its check lands.

      A step that has already answered renders from the stored results, so a reload or a shared
      permalink shows the finished analysis. Only steps still in flight render the placeholder and
      wait for their broadcast. Finished steps render the partial bare: it carries the step id
      itself, which is what the broadcast replaces, so wrapping it would nest the same id twice. %>
  <div class="steps">
    <% Analysis::STEPS.each do |step, title, hint| %>
      <% if (payload = stored[step]) %>
        <%= render "analyses/step", step: step, payload: payload, analysis: @analysis,
                   repo_source: payload[:repo_source] %>
      <% else %>
        <%= tag.div id: "step_#{step}" do %>
          <%= render "analyses/pending", title: title, hint: hint %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</section>
