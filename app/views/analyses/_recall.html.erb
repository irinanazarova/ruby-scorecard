<%# The recall grid: models down the side, your text and the reference pages across the top, every
    number from the identical probe. Rendered bare: this element carries the id the broadcast
    replaces. %>
<% grid = Analyzer::RecallGrid.new(payloads) %>

<div class="recall" id="analysis_recall">
  <%= render "analyses/answer", answer: Analyzer::Verdict.new(payloads).training_answer %>

  <% if !grid.ready? %>
    <%# The one wait on this page long enough to look like a hangup: 9 to 12 real model calls, 60 to
        140 seconds. A single static sentence for that long is indistinguishable from a broken page,
        so this states what is running, which models it is running against, and how far through the
        expected time it is. Elapsed counts from the run's created_at, so a reload shows the true
        wait rather than restarting at zero. %>
    <div class="recall__waiting"
         data-controller="elapsed"
         data-elapsed-started-at-value="<%= (analysis&.created_at || Time.current).to_i %>"
         data-elapsed-expected-value="<%= Analyzer::RecallGrid::EXPECTED_SECONDS %>"
         data-elapsed-deadline-value="<%= AnalyzerConfig.memorization_deadline %>">
      <div class="recall__waithead">
        <span class="spinner" aria-hidden="true"></span>
        <span class="recall__waittitle">Probing each passage against every model</span>
        <span class="recall__clock" data-elapsed-target="clock" aria-live="off">0s</span>
      </div>

      <div class="recall__progress" data-elapsed-target="bar"
           role="progressbar" aria-label="Probe progress"></div>

      <p class="recall__waitnote" data-elapsed-target="note">
        The slow part: <%= Analyzer::RecallGrid::EXPECTED_SECONDS %> seconds is normal, because every
        number here is a real model call rather than a lookup.
      </p>

      <% if grid.expected_models.any? %>
        <ul class="recall__waitmodels">
          <% grid.expected_models.each do |model| %>
            <li><span class="recall__waitdot"></span><%= model[:label] %>
              <code><%= model[:model] %></code></li>
          <% end %>
        </ul>
      <% end %>
    </div>
  <% else %>
    <% scale = grid.scale %>
    <div class="recall__scroll">
      <table class="recall__grid">
        <caption class="visually-hidden">Longest run of consecutive words each model reproduced
        verbatim</caption>
        <thead>
          <tr>
            <th scope="col" class="recall__corner">Longest verbatim run</th>
            <% grid.columns.each do |col| %>
              <th scope="col" class="recall__col recall__col--<%= col.kind %>">
                <span class="recall__collabel">
                  <% if col.href.present? %>
                    <a href="<%= col.href %>" rel="noopener"><%= col.label %></a>
                  <% else %>
                    <%= col.label %>
                  <% end %>
                </span>
                <span class="recall__colsub"><%= col.sublabel %></span>
              </th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% grid.rows.each do |row| %>
            <tr>
              <%# The exact model id, not just the family name. "Claude Opus" will point at
                  different weights in six months, and a recall number that cannot name the snapshot
                  it came from is not reproducible. %>
              <th scope="row" class="recall__model">
                <span class="recall__modelname"><%= row.model %></span>
                <% if row.model_id.present? %>
                  <code class="recall__modelid"><%= row.model_id %></code>
                <% end %>
              </th>
              <% grid.columns.each do |col| %>
                <% cell = row.cells[col.key] %>
                <td class="recall__cell recall__cell--<%= col.kind %> recall__cell--<%= cell.state %>">
                  <% if cell.state == :measured %>
                    <%# The bar is drawn against ONE scale across the whole grid. Scaling each row
                        to its own maximum would make a 2-word run and a 31-word run look alike. %>
                    <span class="bar-track" title="<%= cell.matched.presence || 'no matching run' %>">
                      <span class="bar bar--<%= cell.verdict %>"
                            style="--bar: <%= ((cell.run.to_f / scale) * 100).clamp(0, 100).round %>%"></span>
                    </span><span class="bar__value"><%= cell.run %></span>
                  <% elsif cell.state == :waiting %>
                    <span class="bar__value bar__value--muted">…</span>
                  <% else %>
                    <span class="bar__value bar__value--muted" title="never probed">not asked</span>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <p class="recall__legend">
      Words, not a score. <strong><%= grid.threshold %> or more</strong> consecutive words is the
      bar we call recall: you cannot reproduce text you have never seen.
    </p>
    <%# The controls are still probed on every run; they just no longer take two columns. This
        sentence IS the guarantee: without it a zero could mean "not memorized" or "the probe broke
        today" and there would be no way to tell them apart. %>
    <% case grid.controls_ok?
       when true %>
      <p class="recall__controls recall__controls--ok">
        Controls behaved on this run: the MIT licence text fired on every model and an invented
        passage fired on none. That is what makes a zero above readable as an answer rather than as
        a broken probe.
      </p>
    <% when false %>
      <p class="recall__controls recall__controls--bad">
        The controls misbehaved on this run, so nothing in this grid is interpretable. The MIT
        licence text must fire on every model and the invented passage must fire on none.
      </p>
    <% end %>

    <%# Why the models have it, when they do. Recall on its own is a fact with no handle on it; the
        thing a visitor can act on is that the text is duplicated, because duplication is what the
        study found predicts recall. %>
    <% why = payloads.dig("copies", :result) %>
    <% if why.present? && why[:skipped].blank? %>
      <section class="why">
        <h3 class="why__title">Why the models have this</h3>

        <% if why[:count].nil? %>
          <p class="why__lead">The duplication check could not run just now, which is a fact about
          our GitHub rate limit rather than about your text.</p>
        <% elsif why[:count].to_i.positive? %>
          <p class="why__lead">
            The passage that fired appears in <strong><%= number_with_delimiter(why[:count]) %></strong>
            public <%= "repository".pluralize(why[:count]) %>, none of them forks of each other.
          </p>
          <ul class="why__repos">
            <% Array(why[:repos]).each do |repo| %>
              <li><a href="<%= repo[:url] %>" rel="noopener"><%= repo[:name] %></a></li>
            <% end %>
            <li><a href="<%= why[:search_url] %>" rel="noopener">see the search on GitHub &rarr;</a></li>
          </ul>
          <p class="why__note">
            Copies are what recall tracks: in our 168-repo study the number of independent copies
            predicted verbatim recall (&rho; +0.70) and stars did not (&rho; +0.28).
            <a href="/learn#copies">The working &rarr;</a>
          </p>
        <% else %>
          <p class="why__lead">No other public repository carries this passage.</p>
          <p class="why__note">Which makes the recall harder to explain, not easier to dismiss. This
          search covers public code only, so text duplicated across the web scores zero here.
          <a href="/learn#copies">What copies predict &rarr;</a></p>
        <% end %>

        <p class="why__phrase">
          Searched for the <%= why[:kind].to_s == "code" ? "most distinctive string in" : "opening of" %>
          the passage that fired: <code><%= why[:phrase] %></code>
        </p>
      </section>
    <% end %>

    <p class="recall__caveat">
      A null result is weak evidence. Models memorize a fraction of what they read, so an empty row
      does not prove your text is absent from any corpus. A long run is the strong direction: text
      cannot be reproduced unless it was seen.
      <a href="/learn#memorization">What this can and cannot prove &rarr;</a>
    </p>

    <%# The evidence for the numbers above: the exact prefix each model was shown, what actually
        followed, and what it wrote. Collapsed, because most visitors want the answer and the ones
        who want to disbelieve it should not have to go hunting for the working. Sits here, directly
        under the claim and above the box that invites another go. %>
    <% if grid.evidence.present? %>
      <%= render "analyses/probe_evidence", result: grid.evidence, open: false %>
    <% end %>

    <%# Checking a second paragraph is the obvious next move from a result, and until now it meant
        navigating back to the form. Paragraph only: this runs the probe and nothing else, so it
        costs one model call per model rather than a full analysis, and it does not carry the docs
        URL or repo over -- a different paragraph is a different question about a different text. %>
    <section class="recheck">
      <h3 class="recheck__title">Check another paragraph</h3>
      <%= form_with url: analyses_path, method: :post, class: "recheck__form",
                    data: { controller: "word-count",
                            word_count_min_value: Analyzer::Passage::MIN_PASTED_WORDS } do |f| %>
        <div class="probe-form__labelrow">
          <%= f.label :passage, "Paste the text", class: "recheck__label" %>
          <span class="wordcount" data-word-count-target="output" aria-live="polite"></span>
        </div>
        <%= f.text_area :passage, rows: 4, spellcheck: "false",
              placeholder: "Paste a paragraph, a README section, a config snippet…",
              data: { word_count_target: "input", action: "input->word-count#update" } %>
        <div class="recheck__go">
          <%= f.submit "Check recall", data: { word_count_target: "submit" } %>
          <span class="probe-form__hint">Needs
          <%= Analyzer::Passage::MIN_PASTED_WORDS %> words: we show a model the opening
          <%= Analyzer::Passage::MIN_SEED %> and compare what it writes next against the rest.</span>
          <span class="probe-form__reason" data-word-count-target="reason" role="alert" hidden></span>
        </div>
      <% end %>
    </section>
  <% end %>
</div>
